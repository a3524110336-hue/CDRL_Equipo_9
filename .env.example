# Plantilla de configuración local. No contiene contraseñas.
#
# Copia este archivo a .env y ajusta lo que necesites:  cp .env.example .env
# El .env real está en .gitignore y no se sube nunca.
#
# Completa las contraseñas únicamente en el entorno o en tu .env ignorado.
# NUNCA agregues credenciales reales a Git: ni contraseñas
# de servidores del curso, ni llaves de AWS, ni tokens personales.

# --- PostgreSQL (servicio "postgres" de docker-compose.yml) ---
POSTGRES_DB=cdrl
POSTGRES_USER=cdrl_dev
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
# Si el 5432 ya está ocupado por un PostgreSQL nativo, cambia este puerto
# en tu .env local (por ejemplo 5433). El contenedor sigue escuchando en 5432.
POSTGRES_PORT=5432

# --- Roles M03 (nombres fijos definidos en la migración 0005) ---
# La API solo consume CDRL_WRITER_PASSWORD y CDRL_READER_PASSWORD.
# POSTGRES_USER/POSTGRES_PASSWORD son de administración, no de la API.
# Migrator y ops se entregan únicamente a sus procesos responsables.
# Para inicializar o rotar claves, sigue docs/SECRETS.md: el script de
# rotación necesita variables exportadas, no lee .env por sí mismo.
CDRL_MIGRATOR_PASSWORD=
CDRL_WRITER_PASSWORD=
CDRL_READER_PASSWORD=
CDRL_OPS_PASSWORD=

# --- DynamoDB local (servicio "dynamodb" de docker-compose.yml) ---
DYNAMODB_PORT=8000

# --- AWS Academy Learner Lab ---
# La región sí se versiona; las credenciales NO. Las de Learner Lab son
# temporales: van en tu .env local o en ~/.aws/credentials, nunca aquí.
AWS_REGION=us-east-1
